{
  "name": "pearlie-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:api": "cd ../backend && python -m scripts.dump_openapi ../frontend/node_modules/.openapi.json && cd ../frontend && openapi-typescript node_modules/.openapi.json -o src/lib/api/schema.gen.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^6",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/svelte": "^5",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "eslint-plugin-svelte": "^3",
    "globals": "^16",
    "jsdom": "^27",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5",
    "svelte-check": "^4",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vite": "^7",
    "vitest": "^3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "bits-ui": "^2.22.0"
  }
}
