{
  "name": "pearlie-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:api": "cd ../backend && python -m scripts.dump_openapi ../frontend/node_modules/.openapi.json && cd ../frontend && openapi-typescript node_modules/.openapi.json -o src/lib/api/schema.gen.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6",
    "@testing-library/svelte": "^5",
    "eslint": "^9",
    "eslint-plugin-svelte": "^3",
    "globals": "^16",
    "jsdom": "^27",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vite": "^7",
    "vitest": "^3"
  }
}
