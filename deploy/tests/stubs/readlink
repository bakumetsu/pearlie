#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -ne 1 ]]; then
  echo "BAD readlink $*" >> "$STUB_LOG"
  exit 99
fi

path="$1"
echo "readlink $*" >> "$STUB_LOG"

if [[ ! -e "$path" ]]; then
  exit 1
fi

if [[ -f "$path" && ! -L "$path" ]]; then
  cat "$path"
else
  PATH="$STUB_ORIG_PATH" readlink "$path"
fi
