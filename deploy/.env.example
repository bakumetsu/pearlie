# Copy to .env (never commit .env). Bind to 127.0.0.1 only; reach Pearlie through Tailscale/WireGuard or a reverse proxy with login.

# fixture or real, no default, must be set
PEARLIE_MODE=fixture

# SQLite database file
PEARLIE_DB_PATH=data/pearlie.db

# Pre-built frontend assets
PEARLIE_STATIC_DIR=../frontend/dist

# Bind address
PEARLIE_HOST=127.0.0.1

# Listen port
PEARLIE_PORT=8000

# Stash base URL (e.g. https://stash.example)
PEARLIE_STASH_URL=

# Stash API key
PEARLIE_STASH_API_KEY=

# Komga base URL (e.g. http://komga:8080)
PEARLIE_KOMGA_URL=

# Komga API key
PEARLIE_KOMGA_API_KEY=

# Gelbooru user ID
PEARLIE_GELBOORU_USER_ID=

# Gelbooru API key
PEARLIE_GELBOORU_API_KEY=

# Rule34 user ID
PEARLIE_RULE34_USER_ID=

# Rule34 API key
PEARLIE_RULE34_API_KEY=

# NHentai session cookies (raw Cookie header value)
PEARLIE_NHENTAI_COOKIES=
