# Copy to backend/.env (the backend reads .env from its working directory; never commit .env).
# Pearlie has no login. Keep it on 127.0.0.1 and reach it through Tailscale/WireGuard
# or a reverse proxy with login. Never expose it to the internet directly.

# fixture (stub data, no outside calls) or real. No default, must be set.
PEARLIE_MODE=fixture

# SQLite database file
PEARLIE_DB_PATH=data/pearlie.db

# Pre-built frontend assets
PEARLIE_STATIC_DIR=../frontend/dist

# Bind address and port
PEARLIE_HOST=127.0.0.1
PEARLIE_PORT=8000

# Set to 1 only if access is limited to your tailnet or reverse proxy: allows a non-loopback PEARLIE_HOST (Pearlie has no login).
PEARLIE_TRUSTED_NETWORK=0

# Optional. Comma list of extra host names you reach Pearlie by (e.g. a reverse-proxy name). Every
# request (web UI and /api) whose Host is not an IP address, localhost, *.ts.net or listed here gets 403
# with an error page naming the host (DNS rebinding defence).
# Behind a reverse proxy with its own host name, list that name here (e.g. pearlie.home), then restart.
PEARLIE_ALLOWED_HOSTS=

# Optional. Master key that encrypts keys typed into the Options page. If unset, Pearlie
# generates one on first start and keeps it in secret.key next to the database (owner-only).
# A key set here wins and stays in use.
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PEARLIE_SECRET_KEY=

# Stash base URL (e.g. http://stash:9999) and API key
PEARLIE_STASH_URL=
PEARLIE_STASH_API_KEY=
# Optional: Stash URL as your browser sees it, if different from the one above
PEARLIE_STASH_PUBLIC_URL=

# Stump v0.1.13 (the only book server) base URL (e.g. http://stump:10801) and API key (Bearer; use a user with library access only)
PEARLIE_STUMP_URL=
PEARLIE_STUMP_API_KEY=

# Gelbooru and Rule34 account (needed for API access)
PEARLIE_GELBOORU_USER_ID=
PEARLIE_GELBOORU_API_KEY=
PEARLIE_RULE34_USER_ID=
PEARLIE_RULE34_API_KEY=

# nhentai session cookies (raw Cookie header value)
PEARLIE_NHENTAI_COOKIES=
# Danbooru login + API key and the nhentai User-Agent are set in Options > Site access

# Where Pearlie hands files to Stash (paths as Pearlie sees them)
PEARLIE_STASH_TEMP_DIR=/path/to/stash/Temp
PEARLIE_STASH_DEFAULT_DIR=/path/to/stash/Other
# Path prefix mapping when Pearlie and Stash see the same folder under different paths
PEARLIE_STASH_PATH_PREFIX_PEARLIE=
PEARLIE_STASH_PATH_PREFIX_STASH=

# Pearlie trash: deleted library files wait here until the retention period ends.
# It must be on the SAME volume as the Stash and Stump libraries (files are renamed,
# never copied) and outside every library folder. Create it before you start Pearlie.
PEARLIE_TRASH_DIR=/path/to/media/pearlie-trash

# Stump saves: default incoming folder, work folder and path mapping
# (paths as Pearlie sees them; Pearlie needs write access to the Stump library)
PEARLIE_STUMP_INCOMING_DIR=
PEARLIE_STUMP_TEMP_DIR=/path/to/stump/.pearlie-tmp
PEARLIE_STUMP_PATH_PREFIX_PEARLIE=
PEARLIE_STUMP_PATH_PREFIX_STUMP=
# Run Stump cleanLibrary after a trash when at most this many other items are soft-deleted
PEARLIE_STUMP_CLEAN_MAX_FOREIGN=20

# Seconds to wait for a Stash scan, and between downloads from one site
PEARLIE_STASH_SCAN_TIMEOUT_S=120
PEARLIE_DOWNLOAD_INTERVAL_S=2

# Run the background save worker
PEARLIE_WORKER_ENABLED=true

# Log folder (default: a logs folder next to the database), days to keep daily log files
PEARLIE_LOG_DIR=
PEARLIE_LOG_KEEP_DAYS=7

# Thumbnail cache folder (default: a thumbcache folder next to the database); thumbnails only, safe to delete
PEARLIE_THUMB_CACHE_DIR=
# PEARLIE_LOG_DEBUG=1 turns on debug lines (also switchable on the Options page later)
