# Copy to backend/.env (the backend reads .env from its working directory; never commit .env).
# Pearlie has no login. Keep it on 127.0.0.1 and reach it through Tailscale/WireGuard
# or a reverse proxy with login. Never expose it to the internet directly.

# fixture (stub data, no outside calls) or real. No default, must be set.
PEARLIE_MODE=fixture

# SQLite database file
PEARLIE_DB_PATH=data/pearlie.db

# Pre-built frontend assets
PEARLIE_STATIC_DIR=../frontend/dist

# Bind address and port
PEARLIE_HOST=127.0.0.1
PEARLIE_PORT=8000

# Master key that encrypts keys typed into the Options page.
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PEARLIE_SECRET_KEY=

# Stash base URL (e.g. http://stash:9999) and API key
PEARLIE_STASH_URL=
PEARLIE_STASH_API_KEY=
# Optional: Stash URL as your browser sees it, if different from the one above
PEARLIE_STASH_PUBLIC_URL=

# Komga base URL (e.g. http://komga:25600) and API key
PEARLIE_KOMGA_URL=
PEARLIE_KOMGA_API_KEY=

# Gelbooru and Rule34 account (needed for API access)
PEARLIE_GELBOORU_USER_ID=
PEARLIE_GELBOORU_API_KEY=
PEARLIE_RULE34_USER_ID=
PEARLIE_RULE34_API_KEY=

# nhentai session cookies (raw Cookie header value)
PEARLIE_NHENTAI_COOKIES=

# Where Pearlie hands files to Stash (paths as Pearlie sees them)
PEARLIE_STASH_TEMP_DIR=/path/to/stash/Temp
PEARLIE_STASH_DEFAULT_DIR=/path/to/stash/Other
# Path prefix mapping when Pearlie and Stash see the same folder under different paths
PEARLIE_STASH_PATH_PREFIX_PEARLIE=
PEARLIE_STASH_PATH_PREFIX_STASH=

# Seconds to wait for a Stash scan, and between downloads from one site
PEARLIE_STASH_SCAN_TIMEOUT_S=120
PEARLIE_DOWNLOAD_INTERVAL_S=2

# Run the background save worker
PEARLIE_WORKER_ENABLED=true
